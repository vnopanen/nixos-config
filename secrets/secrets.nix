let
  thinkpad = "";
  rpi = "";
  user = "";

  users = [ user ];
  systems = [
    thinkpad
    rpi
  ];
in
{
  "wifi_rpi.age".publicKeys = users ++ [ rpi ];
  "wifi_thinkpad.age".publicKeys = users ++ [ thinkpad ];
